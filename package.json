{
  "name": "sutemail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_REGISTRY_PATH=.wrangler/registry wrangler dev --port 8788",
    "typecheck": "tsc --noEmit",
    "test:unit": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "build": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "postal-mime": "4.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.2",
    "vitest": "4.1.12",
    "wrangler": "4.153.0",
    "@cloudflare/vitest-plugin": "1.4.8"
  },
  "overrides": {
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  }
}
